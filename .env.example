# LLM 配置（红蓝对抗 / 定价页结构化抽取需要）
# 复制为 .env 并填入真实 key

# 选择 provider：anthropic（默认）或 openai
LLM_PROVIDER=anthropic

# API key（必填）
LLM_API_KEY=sk-ant-your-key-here

# 模型（可选，有默认值）
LLM_MODEL=claude-sonnet-4-5

# 自定义 endpoint（可选，留空用官方）
# LLM_BASE_URL=https://api.anthropic.com

# 工作台端口（可选）
# WORKBENCH_PORT=3737

# 团队规模补强数据源（可选，未配置时自动跳过、报告标注跳过原因）
# UK Companies House（英国官方注册库，免费注册即发 key）
#   https://developer.company-information.service.gov.uk
# COMPANIES_HOUSE_KEY=your-key
# Crunchbase（注意：2025 起无免费 API，最低约 $49/月——不订阅则无需填写）
# CRUNCHBASE_KEY=your-key
